<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can reach helpers that are implementation detail to everyone else: URL
         construction and version formatting are worth pinning, and neither belongs on the public
         surface of a client whose job is to pair and check in. -->
    <InternalsVisibleTo Include="Optimisarr.Sidecar.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Optimisarr.Core/Optimisarr.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
