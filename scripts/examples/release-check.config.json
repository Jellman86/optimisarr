      "sourceCommit": "0000000000000000000000000000000000000000",
      "ffmpegRevision": "0000000000000000000000000000000000000000",
      "nativeHelperRevision": "0000000000000000000000000000000000000000"
    },
    "windows": {
      "path": "/operator/packages/Optimisarr-Sidecar.msi",
      "version": "0.0.0",
      "sourceCommit": "0000000000000000000000000000000000000000",
      "ffmpegRevision": "0000000000000000000000000000000000000000",
      "nativeHelperRevision": "0000000000000000000000000000000000000000"
    }
  },
  "native": {
