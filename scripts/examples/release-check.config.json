    },
    "release-windows": {
      "encoder": "hevc_nvenc",
      "ffmpegRevision": "0000000000000000000000000000000000000000",
      "nativeHelperRevision": "0000000000000000000000000000000000000000",
      "ssh": {
        "host": "operator-windows-alias",
        "python": "python",
        "command": ["C:/operator/build/Optimisarr.Sidecar.Acceptance.exe"],
        "scratchRoot": "C:/operator/acceptance-scratch",
        "serverUrl": "http://operator-test-interface:{port}",
        "tools": {
          "OPTIMISARR_FFMPEG": "C:/operator/package/ffmpeg.exe",
          "OPTIMISARR_FFPROBE": "C:/operator/package/ffprobe.exe",
          "OPTIMISARR_AUDIO_QUALITY": "C:/operator/package/optimisarr-audio-quality.exe",
          "OPTIMISARR_IMAGE_QUALITY": "C:/operator/package/optimisarr-image-quality.exe"
        }
      }
    }
