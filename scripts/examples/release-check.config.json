      "nativeHelperRevision": "0000000000000000000000000000000000000000"
    },
    "release-macos": {
      "encoder": "hevc_videotoolbox",
      "ffmpegRevision": "0000000000000000000000000000000000000000",
      "nativeHelperRevision": "0000000000000000000000000000000000000000",
      "ssh": {
        "host": "operator-mac-alias",
        "python": "python3",
        "command": ["/operator/build/AcceptanceWorker"],
        "scratchRoot": "/operator/acceptance-scratch",
        "serverUrl": "http://operator-test-interface:{port}",
        "tools": {
          "OPTIMISARR_FFMPEG": "/operator/package/ffmpeg",
          "OPTIMISARR_FFPROBE": "/operator/package/ffprobe",
          "OPTIMISARR_NATIVE_HOST": "/operator/package/native-quality-host",
          "OPTIMISARR_AUDIO_QUALITY": "/operator/package/optimisarr-audio-quality",
          "OPTIMISARR_IMAGE_QUALITY": "/operator/package/optimisarr-image-quality"
